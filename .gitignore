# Build products — regenerated by Scripts/build-xcframework.sh
.build/
build/
DerivedData/
Example/ios/build/
Example/ios/DerivedData/
*.xcarchive

# Dependencies — restored by `yarn install` and `pod install`
Example/node_modules/
Example/ios/Pods/
Example/.yarn/
.yarn/

# Podfile.lock and yarn.lock ARE committed on purpose: they pin the exact trees the
# shipped binary was built from, including the SEOS and CLEAR plugin versions.

# Credentials never belong in the repo. The npm token lives in ~/.yarnrc.yml.
.npmrc
.yarnrc.yml

# Xcode / OS noise. Shared schemes under xcshareddata ARE committed — CocoaPods
# does not recreate them, and without them `xcodebuild -scheme` fails on a fresh
# clone.
.DS_Store
xcuserdata/
*.xcuserstate
*.hmap
*.ipa

# Metro / JS
.metro-health-check*
npm-debug.log
yarn-error.log
